# Base de données Postgres (ex. Vercel Postgres / Neon / Supabase)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# SMTP (envoi des e-mails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=

# URL publique du site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optionnel : clé API YouVersion pour le verset du jour
YOUVERSION_API_KEY=
YVP_APP_KEY=
YVP_LSG_BIBLE_ID=

# Compte administrateur initial (créé par la seed)
# admin@adniamey2000.org / admin123 — à changer après le premier lancement

# Google Search Console (méthode balise HTML — obtenir sur search.google.com/search-console)
GOOGLE_VERIFICATION=

# Google Analytics 4 (Measurement ID — obtenir sur analytics.google.com)
GA_MEASUREMENT_ID=

# Vercel Blob (stockage images — obtenu sur vercel.com/dashboard → Storage → Blob)
BLOB_READ_WRITE_TOKEN=
